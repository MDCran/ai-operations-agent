# Copy to .env and replace the database password and demo password before starting.
POSTGRES_PASSWORD=operations-local-only
DATABASE_URL=postgresql+psycopg://operations:operations-local-only@postgres:5432/operations
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
AI_PROVIDER=demo
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
DEMO_EMAIL=owner@example.com
DEMO_PASSWORD=change-this-local-password
# Optional, disabled by default. Review data policy before sending traces externally.
LANGSMITH_TRACING=false
# Set per your provider contract; unset costs are reported as unknown.
MODEL_INPUT_COST_PER_MILLION=
MODEL_OUTPUT_COST_PER_MILLION=
